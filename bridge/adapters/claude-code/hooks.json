{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "codexmicro-notify 0 thinking" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "codexmicro-notify 0 thinking" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "codexmicro-notify 0 needs_input" } ] }
